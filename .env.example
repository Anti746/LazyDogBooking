# Supabase credentials are injected by the v0 integration. Never commit real values.
# Keep the secret key server-only; do not prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Required in every environment. Admin login remains disabled until both are set.
# Use an independently generated 16+ character password and 32+ character session secret.
ADMIN_PASSWORD=
SESSION_SECRET=

# Booking emails — the same Gmail account and App Password as the Surf Wala
# project. GMAIL_APP_PASSWORD is a Google "App password" (Google Account →
# Security → 2-Step Verification → App passwords), not the normal password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
