# ── Copy to .env.local for local development. On your host (e.g. Vercel),
# ── set these as environment variables. NEVER commit real values to git.

# Supabase → Project Settings → Database → Connection string → "Transaction pooler".
# Use the lazydog_app role (see README), NOT the postgres superuser:
# postgresql://lazydog_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Optional but recommended: Supabase → Project Settings → Database → SSL Configuration
# → download certificate, paste its contents here (newlines as \n). Enables full
# TLS certificate verification for the database connection.
DATABASE_CA_CERT=

# Admin password. In production it MUST be at least 12 characters, otherwise
# the admin login is disabled. (Locally it defaults to 0000.)
ADMIN_PASSWORD=

# Optional extra secret for signing admin sessions (any long random string).
SESSION_SECRET=
